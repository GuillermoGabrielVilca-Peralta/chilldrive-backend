{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Cadena de conexión a PostgreSQL SIN contraseña (no es secreto). La contraseña real va en
  // User Secrets (dev) o en la variable de entorno ConnectionStrings__DefaultConnection (prod),
  // que sobreescriben esta clave completa. Va bajo "ConnectionStrings" para que GetConnectionString la encuentre.
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=chilldrive;Username=postgres;Port=5432"
  },

  // Orígenes permitidos en producción — completar al desplegar la app.
  // En Development se sobreescribe desde appsettings.Development.json con localhost.
  "Cors": {
    "AllowedOrigins": []
  },

  // Correos de los usuarios con rol Admin. Al iniciar sesión, si el correo está
  // en esta lista se le agrega el claim de rol "Admin" en el JWT. Cambia/añade los reales.
  "Admin": {
    "Correos": [ "admin@chilldrive.pe" ]
  },

  // Configuración JWT. SecretKey NO se define aquí (es secreto): va en User Secrets (dev) o
  // en la variable de entorno Jwt__SecretKey (prod). Issuer/Audience/Expiración no son secretos.
  "Jwt": {
    "SecretKey":       "",
    "Issuer":          "ChillDriveAPI",
    "Audience":        "ChillDriveCliente",
    "ExpirationHours": 24,
    // El refresh token es un JWT de larga vida con una AUDIENCE distinta
    // (ChillDriveRefresh). Al no ser 'ChillDriveCliente', el validador de acceso de
    // Program.cs lo rechaza en endpoints protegidos: solo sirve en /api/auth/refresh.
    "RefreshAudience":       "ChillDriveRefresh",
    "RefreshExpirationDays": 30
  }
}
