# Copia este archivo como .env y rellena los valores reales.
# El archivo .env está en .gitignore — nunca lo subas al repo.

# Contraseña del usuario 'postgres' dentro del contenedor
POSTGRES_PASSWORD=cambia_esto_por_una_clave_segura

# Clave secreta para firmar los JWT. Mínimo 32 caracteres aleatorios.
# Genera una con: openssl rand -base64 48
JWT_SECRET_KEY=cambia_esto_por_una_clave_larga_y_aleatoria

# Correo del administrador (el que recibe el claim de rol Admin al hacer login)
ADMIN_CORREO=admin@chilldrive.pe
